{
  "id": "diag-auto-review",
  "version": "1.0.0",
  "contract_version": 1,
  "purpose": "Binds an external CLI review/fix agent to Axiom diag skills: auto-resolves findings, reviews code, and proposes updates under skill rules and human gates.",
  "capabilities": [
    "diag-auto-review"
  ],
  "inputs": [
    "project_profile",
    "artifact_context",
    "task"
  ],
  "outputs": [
    "findings",
    "artifact_updates",
    "evidence"
  ],
  "permissions": {
    "filesystem": "write",
    "git_push": false,
    "release": false
  },
  "approval": {
    "required_for_sensitive_change": true
  },
  "skills": [
    "automotive-diagnostics",
    "code-review"
  ],
  "external": {
    "cli": "acme-code-agent",
    "pip": "acme-code-agent>=1.4,<2",
    "modes": [
      "review",
      "fix",
      "update"
    ]
  },
  "domain_aware": true,
  "requires_project_context": true,
  "skill_binding": {
    "core_skill": "automotive-diagnostics",
    "overlay_source": "configs/domain-routing.yaml",
    "resolver": "packages/agents/project_context.py",
    "matrix": "matrix[diag-auto-review]",
    "token_budget": {
      "primary_cap": 8,
      "group_cap": 12,
      "max_context_files": 8
    },
    "clarify_when": "needs_clarification=true (fallback or repo/prompt conflict)"
  },
  "output_contract": [
    "verdict",
    "domain_used",
    "skills_loaded",
    "skills_deferred",
    "standards_applied",
    "evidence_refs",
    "approval_gate",
    "followups"
  ]
}
