{
  "id": "security",
  "version": "1.0.0",
  "contract_version": 1,
  "purpose": "Performs secure-development and threat-oriented checks.",
  "capabilities": [
    "security"
  ],
  "inputs": [
    "project_profile",
    "artifact_context",
    "task"
  ],
  "outputs": [
    "findings",
    "artifact_updates",
    "evidence"
  ],
  "permissions": {
    "filesystem": "read",
    "git_push": false,
    "release": false
  },
  "approval": {
    "required_for_sensitive_change": true
  },
  "domain_aware": true,
  "requires_project_context": true,
  "skill_binding": {
    "overlay_source": "configs/domain-routing.yaml",
    "resolver": "packages/agents/project_context.py"
  }
}
