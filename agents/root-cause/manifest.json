{
  "id": "root-cause",
  "version": "1.0.0",
  "contract_version": 1,
  "purpose": "Builds evidence-backed causal hypotheses and verification plans.",
  "capabilities": [
    "root-cause"
  ],
  "inputs": [
    "project_profile",
    "artifact_context",
    "task"
  ],
  "outputs": [
    "findings",
    "artifact_updates",
    "evidence"
  ],
  "permissions": {
    "filesystem": "read",
    "git_push": false,
    "release": false
  },
  "approval": {
    "required_for_sensitive_change": true
  },
  "domain_aware": true,
  "requires_project_context": true,
  "skill_binding": {
    "core_skill": "debugging",
    "overlay_source": "configs/domain-routing.yaml",
    "resolver": "packages/agents/project_context.py",
    "matrix": "matrix[root-cause]",
    "token_budget": {
      "primary_cap": 8,
      "group_cap": 12,
      "max_context_files": 8
    },
    "clarify_when": "needs_clarification=true (fallback or repo/prompt conflict)"
  },
  "output_contract": [
    "verdict",
    "domain_used",
    "skills_loaded",
    "skills_deferred",
    "standards_applied",
    "evidence_refs",
    "approval_gate",
    "followups"
  ]
}
