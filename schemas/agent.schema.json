{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AxiomEmbedded Agent Manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "purpose",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "contract_version": {
      "type": "integer"
    },
    "purpose": {
      "type": "string"
    },
    "capabilities": {
      "type": "array"
    },
    "inputs": {
      "type": "array"
    },
    "outputs": {
      "type": "array"
    },
    "permissions": {
      "type": "object"
    }
  }
}
