{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AxiomEmbedded Hazard and Risk Artifact",
  "type": "object",
  "allOf": [{"$ref": "assurance-envelope.schema.json"}],
  "required": ["artifact_id", "schema_version", "kind", "status", "domain", "created_at", "updated_at", "author", "approval_status", "hazards"],
  "properties": {
    "kind": {"const": "hazard-risk"},
    "hazards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "severity", "controls"],
        "properties": {
          "id": {"type": "string", "pattern": "^HAZ-[0-9]+$"},
          "description": {"type": "string"},
          "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "controls": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string"}
        }
      }
    }
  }
}
