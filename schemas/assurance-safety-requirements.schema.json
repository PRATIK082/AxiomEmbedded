{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AxiomEmbedded Safety Requirements Artifact",
  "type": "object",
  "allOf": [{"$ref": "assurance-envelope.schema.json"}],
  "required": ["artifact_id", "schema_version", "kind", "status", "domain", "created_at", "updated_at", "author", "approval_status", "requirements"],
  "properties": {
    "kind": {"const": "safety-requirements"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^REQ-[0-9]+$"},
          "text": {"type": "string"},
          "covers_hazards": {"type": "array", "items": {"type": "string"}},
          "verification": {"type": "string", "enum": ["test", "inspection", "analysis", "OPEN"]},
          "status": {"type": "string"}
        }
      }
    }
  }
}
