{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AxiomEmbedded Skill Manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "contract_version": {
      "type": "integer"
    },
    "type": {
      "type": "string"
    },
    "source_of_truth": {
      "type": "object"
    },
    "context": {
      "type": "object"
    }
  }
}
