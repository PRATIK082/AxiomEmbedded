{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs/agents/working-agreement.md",
    "docs/architecture/context-policy.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "python -m pytest*": "allow",
      "python -m compileall*": "allow",
      "git push*": "ask"
    },
    "edit": "ask",
    "external_directory": "deny"
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "reviewer": {
      "mode": "subagent",
      "permission": {
        "edit": "deny"
      }
    }
  },
  "//": "Generated by scripts/sync_clients.py \u2014 do not edit by hand. Source: skills/ agents/.",
  "mcp": {
    "axiom-embedded": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "axiom_cli",
        "mcp"
      ],
      "enabled": true
    }
  }
}
